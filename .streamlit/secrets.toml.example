# Copy this file to .streamlit/secrets.toml for local Streamlit secrets,
# OR paste its contents into Streamlit Cloud: App → Settings → Secrets.
# Do NOT commit the real secrets.toml (it is gitignored).

OPENAI_API_KEY = "sk-your-key-here"
OPENAI_MODEL_NAME = "gpt-4o-mini"

# Optional: enables the SerperDevTool web-search tool for CTO/CMO/Sales agents.
# SERPER_API_KEY = "your-serper-key"
